# ============================================================
# YatraSetu — Environment Configuration Template
# ============================================================
#
# Copy this file to .env for local development and replace
# placeholder values with your actual local credentials.
#
# NEVER commit .env to Git or share it publicly.
# This file is safe to commit because it contains placeholders only.
# ============================================================


# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------

# Long random secret used by Flask to sign session cookies.
# Generate a strong random value for the real .env file.
SECRET_KEY=replace-with-a-long-random-secret

# Development or production debug flag (true for development, false for production).
# Flask 2.3+ uses FLASK_DEBUG instead of deprecated FLASK_ENV.
FLASK_DEBUG=true


# ------------------------------------------------------------
# MySQL Database
# ------------------------------------------------------------

# MySQL server hostname.
MYSQL_HOST=localhost

# MySQL server TCP port.
MYSQL_PORT=3306

# MySQL username.
MYSQL_USER=your-mysql-username

# MySQL password.
MYSQL_PASSWORD=your-mysql-password

# Database/schema created for YatraSetu.
MYSQL_DATABASE=yatrasetu


# ------------------------------------------------------------
# External APIs
# ------------------------------------------------------------

# Gemini API key.
# Used server-side only by services/gemini_service.py.
# NEVER expose this value to frontend JavaScript.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Weather provider API key.
# Used server-side only by services/weather_service.py.
# NEVER expose this value to frontend JavaScript.
WEATHER_API_KEY=replace-with-your-weather-api-key


# ------------------------------------------------------------
# Prototype Admin Authentication
# ------------------------------------------------------------

# Username for the lightweight Tourism Board prototype admin.
ADMIN_USERNAME=admin

# Werkzeug password hash for the admin password.
# Do NOT put the plaintext admin password here.
# Generate the hash locally with Werkzeug's
# generate_password_hash() and paste the resulting hash here.
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash
